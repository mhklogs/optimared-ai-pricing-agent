# GEMINI_API_KEY: Required for Gemini AI pricing analysis.
# Without it the app runs fully in a sandbox/fallback simulation mode
# (heuristic engine + local heuristics) so the UI never crashes.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: The Gemini model used for AI pricing recommendations.
# Override this if you want a different model (e.g. gemini-2.5-flash).
GEMINI_MODEL="gemini-3.5-flash"

# PORT: Local dev server port (defaults to 3000).
PORT="3000"

# APP_URL: The public URL where the app is hosted (used for self-referential links).
APP_URL="http://localhost:3000"